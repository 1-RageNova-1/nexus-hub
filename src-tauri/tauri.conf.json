{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexus",
  "version": "0.1.1",
  "identifier": "com.sasha.nexus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "enableGTKAppId": true ,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nexus",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
